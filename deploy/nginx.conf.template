# nginx in front of the backend: TLS termination + streaming (SSE) of the chat answers.
# Used by docker-compose.prod.yml. The image's start script replaces ${NGINX_SERVER_NAME}
# (from .env.docker) and leaves nginx's own $variables alone.

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # The backend adds HSTS itself when it sees HTTPS; hide that copy so the header exists exactly once.
    proxy_hide_header Strict-Transport-Security;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # The backend accepts up to 20 MB per request (a chat image as base64 is ~11 MB).
    client_max_body_size 20m;

    location / {
        proxy_pass http://backend:8001;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # --- Server-Sent Events (streamed chat answers) -------------------
        # Without these the answer would arrive in one piece at the end (or time out)
        # instead of token by token.
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
