# Copy to ".env.docker" (same folder as docker-compose.yml) and fill in the real values.
# ".env.docker" must NOT be committed (add it to .gitignore).
# Your normal ".env" for "fastapi dev" stays separate (see the CHAT_DATABASE_URL note below).

# --- LLM -------------------------------------------------------------
MISTRAL_API_KEY=xxx
MISTRAL_MODEL=ministral-8b-2512
MISTRAL_VISION_MODEL=ministral-8b-2512

# --- Auth between Moodle plugin and backend ----------------------------
# Do not invent these by hand: "scripts/generate-secrets.ps1" (Windows) or
# "scripts/generate-secrets.sh" (Linux) creates ".env.docker" from this file with
# random values for MOODLE_SECRET, INTERNAL_API_KEY and POSTGRES_PASSWORD.
# MOODLE_SECRET   = "api_secret" in the Moodle plugin settings (signs every request)
# INTERNAL_API_KEY = "internal_api_key" in the Moodle plugin settings (re-indexing)
MOODLE_SECRET=xxx
INTERNAL_API_KEY=xxx

# --- Rate limit (requests per Moodle user and minute, 0 = off) ---------
# "LLM" counts everything that makes the model answer (send, edit, regenerate).
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_LLM_PER_MIN=12

# --- App ---------------------------------------------------------------
LOG_LEVEL=INFO
# "production" switches the interactive API docs (/docs) off. Use it on the VM.
ENVIRONMENT=development
DEBUG=true
MOODLE_BASE_URL=http://127.0.0.1

# --- Chat database: our own PostgreSQL (service "db" in docker-compose) --
# Use only letters and digits in the password (it is embedded in a URL).
# The backend's CHAT_DATABASE_URL is built from these three by docker-compose.
POSTGRES_USER=sdgchat
POSTGRES_PASSWORD=change_me_to_a_long_password
POSTGRES_DB=sdgchat
# Port on YOUR PC for tools and "fastapi dev" (the container itself never uses it).
# Change it if Windows says the port is not available.
POSTGRES_HOST_PORT=15432

# --- Moodle's database (READ ONLY use: course texts, PDFs, enrolments) ---
# Inside the container "localhost" is the container itself, so use
# host.docker.internal. Port 3306 = MariaDB of the Moodle Windows installer.
DATABASE_URL=mysql+pymysql://root:xxx@host.docker.internal:3306/moodle

# --- HTTPS reverse proxy (only with docker-compose.prod.yml) -----------
# Host name of the backend, as in the TLS certificate (deploy/certs/).
NGINX_SERVER_NAME=backend.example.org

# --- Embeddings --------------------------------------------------------
# The model is baked into the image at build time (see Dockerfile).
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# --- Used ONLY by docker-compose (not by the app) ----------------------
# Windows path to Moodle's moodledata, with forward slashes.
MOODLEDATA_HOST_PATH=D:/Moodle/MoodleWindowsInstaller-latest-500/server/moodledata

# =======================================================================
# For your normal ".env" (used by "fastapi dev" on Windows) add this line.
# Same user/password/db as above; the port is POSTGRES_HOST_PORT. Start the database first:
#   docker compose --env-file .env.docker up -d db
#
# CHAT_DATABASE_URL=postgresql+psycopg://sdgchat:SAME_PASSWORD_AS_ABOVE@127.0.0.1:15432/sdgchat
# =======================================================================
